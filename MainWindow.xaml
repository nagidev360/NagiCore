<Window x:Class="NagiCore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NagiCore" Width="1100" Height="700" MinWidth="900" MinHeight="580" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="NagiCore" Foreground="{StaticResource Text}" FontSize="30" FontWeight="Bold"/><TextBlock Text="All-in-One Windows Utility Suite" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="12">
    <StackPanel>
     <Button Content="Dashboard" Height="40" Margin="0,0,0,7" Click="Dashboard_Click"/>
     <Button Content="Discord" Height="40" Margin="0,0,0,7" Click="Discord_Click"/>
     <Button Content="System" Height="40" Margin="0,0,0,7" Click="System_Click"/>
     <Button Content="Settings" Height="40" Margin="0,0,0,7" Click="Settings_Click"/>
     <Button Content="Logs" Height="40" Margin="0,0,0,7" Click="Logs_Click"/>
     <Button Content="License" Height="40" Margin="0,0,0,7" Click="License_Click"/>
     <Button Content="About" Height="40" Click="About_Click"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="26">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="TitleText" Text="Dashboard" Foreground="{StaticResource Text}" FontSize="25" FontWeight="SemiBold"/>
     <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,8,0,18" TextWrapping="Wrap"/>
     <StackPanel x:Name="DashboardPanel">
      <TextBlock Text="Application status" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="DashboardDetails" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="DiscordPanel" Visibility="Collapsed">
      <TextBlock Text="Discord" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Secure bot connection and developer tools" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
      <TextBlock Text="Bot Token" Foreground="{StaticResource Text}"/>
      <PasswordBox x:Name="DiscordTokenBox" Height="42" Padding="10" Margin="0,6,0,10"/>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="DiscordConnectButton" Content="Connect &amp; Verify" Padding="16,8" Margin="0,0,8,0" Click="DiscordConnect_Click"/>
       <Button Content="Disconnect" Padding="16,8" Click="DiscordDisconnect_Click"/>
      </StackPanel>
      <TextBlock x:Name="DiscordStatus" Foreground="{StaticResource Muted}" Margin="0,12,0,18" TextWrapping="Wrap"/>
      <TextBlock Text="Bot identity" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock x:Name="DiscordIdentity" Foreground="{StaticResource Muted}" Margin="0,6,0,16"/>
      <TextBlock Text="Server ID" Foreground="{StaticResource Text}"/>
      <TextBox x:Name="DiscordGuildIdBox" Height="38" Margin="0,6,0,8"/>
      <Button Content="Get Server Info" Padding="16,8" HorizontalAlignment="Left" Click="DiscordGuild_Click"/>
      <TextBlock Text="User ID" Foreground="{StaticResource Text}" Margin="0,16,0,0"/>
      <TextBox x:Name="DiscordUserIdBox" Height="38" Margin="0,6,0,8"/>
      <Button Content="Get User Info" Padding="16,8" HorizontalAlignment="Left" Click="DiscordUser_Click"/>
      <Button Content="List My Servers" Padding="16,8" Margin="0,16,0,0" HorizontalAlignment="Left" Click="DiscordGuilds_Click"/>
      <TextBox x:Name="DiscordOutputBox" Height="220" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
      <TextBlock Text="Compatibility &amp; system information" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="SystemDetails" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
      <TextBlock Text="Settings" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <CheckBox x:Name="DarkModeBox" Content="Dark mode" Margin="0,14,0,7" Foreground="{StaticResource Text}" IsChecked="True"/>
      <CheckBox x:Name="NotificationsBox" Content="Enable notifications" Margin="0,0,0,7" Foreground="{StaticResource Text}"/>
      <CheckBox x:Name="UpdatesBox" Content="Check for updates" Margin="0,0,0,14" Foreground="{StaticResource Text}"/>
      <StackPanel Orientation="Horizontal"><Button Content="Save settings" Padding="16,8" Margin="0,0,8,0" Click="SaveSettings_Click"/><Button Content="Reset" Padding="16,8" Click="ResetSettings_Click"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Export settings" Padding="16,8" Margin="0,0,8,0" Click="ExportSettings_Click"/><Button Content="Import settings" Padding="16,8" Click="ImportSettings_Click"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="LogsPanel" Visibility="Collapsed">
      <TextBlock Text="Application logs" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBox x:Name="LogBox" Margin="0,10,0,10" Height="360" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal"><Button Content="Refresh" Padding="16,8" Margin="0,0,8,0" Click="RefreshLogs_Click"/><Button Content="Export log" Padding="16,8" Click="ExportLog_Click"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="LicensePanel" Visibility="Collapsed">
      <TextBlock Text="License" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="LicenseDetails" Foreground="{StaticResource Muted}" Margin="0,10,0,14" TextWrapping="Wrap"/>
      <TextBox x:Name="KeyBox" Height="42" Padding="10"/>
      <Button x:Name="ActivateButton" Content="Activate license" Height="42" Margin="0,10,0,0" Click="Activate_Click"/>
     </StackPanel>
     <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
      <TextBlock Text="About NagiCore" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="NagiCore 1.0.0&#10;All-in-One Windows Utility Suite&#10;&#10;Built with C# / WPF / .NET Framework 4.8.&#10;The application reports unsupported Windows baselines instead of falsely claiming compatibility." Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>