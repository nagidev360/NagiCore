<Window x:Class="NagiCore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NagiCore" Width="1200" Height="760" MinWidth="980" MinHeight="620" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="NagiCore" Foreground="{StaticResource Text}" FontSize="30" FontWeight="Bold"/><TextBlock Text="All-in-One Windows Utility Suite" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Button Content="Dashboard" Height="38" Margin="0,0,0,6" Click="Dashboard_Click"/>
     <Button Content="Barcode" Height="38" Margin="0,0,0,6" Click="Barcode_Click"/>
     <Button Content="Billing" Height="38" Margin="0,0,0,6" Click="Billing_Click"/>
     <Button Content="Diamond" Height="38" Margin="0,0,0,6" Click="Diamond_Click"/>
     <Button Content="Discord" Height="38" Margin="0,0,0,6" Click="Discord_Click"/>
     <Button Content="Windows" Height="38" Margin="0,0,0,6" Click="Windows_Click"/>
     <Button Content="Settings" Height="38" Margin="0,0,0,6" Click="Settings_Click"/>
     <Button Content="Logs" Height="38" Margin="0,0,0,6" Click="Logs_Click"/>
     <Button Content="License" Height="38" Margin="0,0,0,6" Click="License_Click"/>
     <Button Content="About" Height="38" Click="About_Click"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="TitleText" Text="Dashboard" Foreground="{StaticResource Text}" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,6,0,16" TextWrapping="Wrap"/>

     <StackPanel x:Name="DashboardPanel">
      <TextBlock Text="Application status" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="DashboardDetails" Foreground="{StaticResource Muted}" Margin="0,8,0,18" TextWrapping="Wrap"/>
      <WrapPanel>
       <Button Content="Open Barcode" Padding="16,8" Margin="0,0,8,8" Click="Barcode_Click"/>
       <Button Content="Open Billing" Padding="16,8" Margin="0,0,8,8" Click="Billing_Click"/>
       <Button Content="Open Diamond" Padding="16,8" Margin="0,0,8,8" Click="Diamond_Click"/>
       <Button Content="Open Windows" Padding="16,8" Margin="0,0,8,8" Click="Windows_Click"/>
      </WrapPanel>
     </StackPanel>

     <StackPanel x:Name="BarcodePanel" Visibility="Collapsed">
      <TextBlock Text="Barcode &amp; QR" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Generate valid codes, scan images, preview, export PNG/PDF and print." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
       <TextBox x:Name="BarcodeTextBox" Height="38" Margin="0,0,8,8"/>
       <ComboBox x:Name="BarcodeFormatBox" Grid.Column="1" Height="38" Margin="0,0,8,8"><ComboBoxItem Content="QR_CODE" IsSelected="True"/><ComboBoxItem Content="CODE_128"/><ComboBoxItem Content="EAN_13"/><ComboBoxItem Content="UPC_A"/><ComboBoxItem Content="DATA_MATRIX"/><ComboBoxItem Content="PDF_417"/></ComboBox>
       <TextBox x:Name="BarcodeWidthBox" Grid.Column="2" Height="38" Text="500" Margin="0,0,8,8"/>
       <TextBox x:Name="BarcodeHeightBox" Grid.Column="3" Height="38" Text="500" Margin="0,0,0,8"/>
      </Grid>
      <WrapPanel><Button Content="Generate" Padding="15,8" Margin="0,0,8,8" Click="BarcodeGenerate_Click"/><Button Content="Scan Image" Padding="15,8" Margin="0,0,8,8" Click="BarcodeScan_Click"/><Button Content="Export PNG" Padding="15,8" Margin="0,0,8,8" Click="BarcodePng_Click"/><Button Content="Export PDF" Padding="15,8" Margin="0,0,8,8" Click="BarcodePdf_Click"/><Button Content="Print" Padding="15,8" Click="BarcodePrint_Click"/></WrapPanel>
      <Image x:Name="BarcodePreview" Height="280" Stretch="Uniform" Margin="0,10,0,8"/>
      <TextBlock x:Name="BarcodeResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     </StackPanel>

     <StackPanel x:Name="BillingPanel" Visibility="Collapsed">
      <TextBlock Text="Billing" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Create invoices with exact decimal calculations and persistent history." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="Customer" Foreground="{StaticResource Text}"/><TextBox x:Name="BillCustomer" Height="34" Margin="0,4,0,6"/><TextBlock Text="Phone" Foreground="{StaticResource Text}"/><TextBox x:Name="BillPhone" Height="34" Margin="0,4,0,6"/><TextBlock Text="Address" Foreground="{StaticResource Text}"/><TextBox x:Name="BillAddress" Height="55" Margin="0,4,0,6" TextWrapping="Wrap"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="Item / Service" Foreground="{StaticResource Text}"/><TextBox x:Name="BillItem" Height="34" Margin="0,4,0,6"/><WrapPanel><TextBox x:Name="BillQty" Width="80" Height="34" Text="1" Margin="0,0,6,6"/><TextBox x:Name="BillPrice" Width="100" Height="34" Text="0" Margin="0,0,6,6"/><TextBox x:Name="BillTax" Width="80" Height="34" Text="0" Margin="0,0,6,6"/><TextBox x:Name="BillDiscount" Width="90" Height="34" Text="0" Margin="0,0,6,6"/></WrapPanel><Button Content="Add item" Padding="14,7" HorizontalAlignment="Left" Click="BillAddItem_Click"/><ListBox x:Name="BillItemsList" Height="110" Margin="0,8,0,6"/><ComboBox x:Name="BillStatusBox" Height="34"><ComboBoxItem Content="Pending" IsSelected="True"/><ComboBoxItem Content="Paid"/><ComboBoxItem Content="Partial"/><ComboBoxItem Content="Cancelled"/></ComboBox></StackPanel>
      </Grid>
      <TextBlock x:Name="BillTotalText" Foreground="{StaticResource Text}" FontSize="16" Margin="0,10,0,8"/>
      <WrapPanel><Button Content="Create Invoice" Padding="15,8" Margin="0,0,8,8" Click="BillCreate_Click"/><Button Content="Save Selected Changes" Padding="15,8" Margin="0,0,8,8" Click="BillUpdate_Click"/><Button Content="Refresh History" Padding="15,8" Margin="0,0,8,8" Click="BillRefresh_Click"/><Button Content="Export CSV" Padding="15,8" Margin="0,0,8,8" Click="BillCsv_Click"/><Button Content="Delete Selected" Padding="15,8" Margin="0,0,8,8" Click="BillDelete_Click"/><Button Content="Export Selected PDF" Padding="15,8" Click="BillPdf_Click"/></WrapPanel>
      <ListBox x:Name="BillHistoryList" Height="180" Margin="0,8,0,0" DisplayMemberPath="InvoiceNumber" SelectionChanged="BillHistory_SelectionChanged"/>
     </StackPanel>

     <StackPanel x:Name="DiamondPanel" Visibility="Collapsed">
      <TextBlock Text="Diamond" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Inventory records only; NagiCore does not invent market valuation data." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,6,0"><TextBox x:Name="DiaRef" Height="34" ToolTip="Reference number"/><TextBox x:Name="DiaWeight" Height="34" Margin="0,6,0,0" ToolTip="Weight"/><TextBox x:Name="DiaSize" Height="34" Margin="0,6,0,0" ToolTip="Size"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBox x:Name="DiaShape" Height="34" ToolTip="Shape"/><TextBox x:Name="DiaColor" Height="34" Margin="0,6,0,0" ToolTip="Color"/><TextBox x:Name="DiaClarity" Height="34" Margin="0,6,0,0" ToolTip="Clarity"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBox x:Name="DiaCut" Height="34" ToolTip="Cut"/><TextBox x:Name="DiaPrice" Height="34" Margin="0,6,0,0" ToolTip="Recorded price/value"/><TextBox x:Name="DiaSearch" Height="34" Margin="0,6,0,0" ToolTip="Search"/></StackPanel>
       <StackPanel Grid.Column="3"><Button Content="Save / Add" Height="34" Click="DiaSave_Click"/><Button Content="Delete Selected" Height="34" Margin="0,6,0,0" Click="DiaDelete_Click"/><Button Content="Search" Height="34" Margin="0,6,0,0" Click="DiaRefresh_Click"/><Button Content="Export CSV" Height="34" Margin="0,6,0,0" Click="DiaExport_Click"/><Button Content="Import CSV" Height="34" Margin="0,6,0,0" Click="DiaImport_Click"/></StackPanel>
      </Grid>
      <ListBox x:Name="DiaList" Height="250" Margin="0,12,0,0" DisplayMemberPath="ReferenceNumber"/>
     </StackPanel>

     <StackPanel x:Name="DiscordPanel" Visibility="Collapsed">
      <TextBlock Text="Discord" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Bot credentials are encrypted with Windows DPAPI and are never logged." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
      <PasswordBox x:Name="DiscordTokenBox" Height="40" Margin="0,0,0,8"/>
      <WrapPanel><Button x:Name="DiscordConnectButton" Content="Connect &amp; Verify" Padding="15,8" Margin="0,0,8,8" Click="DiscordConnect_Click"/><Button Content="Disconnect" Padding="15,8" Click="DiscordDisconnect_Click"/></WrapPanel>
      <TextBlock x:Name="DiscordStatus" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <TextBlock x:Name="DiscordIdentity" Foreground="{StaticResource Muted}"/>
      <WrapPanel Margin="0,12,0,0"><TextBox x:Name="DiscordGuildIdBox" Width="210" Height="34" Margin="0,0,6,6"/><Button Content="Server Info" Padding="12,7" Margin="0,0,6,6" Click="DiscordGuild_Click"/><TextBox x:Name="DiscordUserIdBox" Width="210" Height="34" Margin="0,0,6,6"/><Button Content="User Info" Padding="12,7" Margin="0,0,6,6" Click="DiscordUser_Click"/><Button Content="My Servers" Padding="12,7" Click="DiscordGuilds_Click"/></WrapPanel>
      <TextBox x:Name="DiscordOutputBox" Height="230" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
     </StackPanel>

     <StackPanel x:Name="WindowsPanel" Visibility="Collapsed">
      <TextBlock Text="Windows" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="WindowsDetails" Foreground="{StaticResource Muted}" Margin="0,8,0,14" TextWrapping="Wrap"/>
      <CheckBox x:Name="StartupBox" Content="Start NagiCore with Windows" Foreground="{StaticResource Text}" Margin="0,0,0,10" Click="Startup_Click"/>
      <WrapPanel><Button Content="Refresh system" Padding="15,8" Margin="0,0,8,8" Click="WindowsRefresh_Click"/><Button Content="Open System Info" Padding="15,8" Click="WindowsInfo_Click"/></WrapPanel>
     </StackPanel>

     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
      <TextBlock Text="Settings" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
      <CheckBox x:Name="DarkModeBox" Content="Dark mode" Margin="0,14,0,7" Foreground="{StaticResource Text}" IsChecked="True"/>
      <CheckBox x:Name="NotificationsBox" Content="Enable notifications" Margin="0,0,0,7" Foreground="{StaticResource Text}"/>
      <CheckBox x:Name="UpdatesBox" Content="Check for updates" Margin="0,0,0,14" Foreground="{StaticResource Text}"/>
      <StackPanel Orientation="Horizontal"><Button Content="Save settings" Padding="16,8" Margin="0,0,8,0" Click="SaveSettings_Click"/><Button Content="Reset" Padding="16,8" Click="ResetSettings_Click"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Export settings" Padding="16,8" Margin="0,0,8,0" Click="ExportSettings_Click"/><Button Content="Import settings" Padding="16,8" Click="ImportSettings_Click"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="LogsPanel" Visibility="Collapsed"><TextBlock Text="Application logs" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="LogBox" Margin="0,10,0,10" Height="360" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="Refresh" Padding="16,8" Margin="0,0,8,0" Click="RefreshLogs_Click"/><Button Content="Export log" Padding="16,8" Click="ExportLog_Click"/></StackPanel></StackPanel>
     <StackPanel x:Name="LicensePanel" Visibility="Collapsed"><TextBlock Text="License" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="LicenseDetails" Foreground="{StaticResource Muted}" Margin="0,10,0,14"/><TextBox x:Name="KeyBox" Height="42"/><Button x:Name="ActivateButton" Content="Activate license" Height="42" Margin="0,10,0,0" Click="Activate_Click"/></StackPanel>
     <StackPanel x:Name="AboutPanel" Visibility="Collapsed"><TextBlock Text="About NagiCore" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="NagiCore 1.0.0&#10;All-in-One Windows Utility Suite&#10;&#10;C# / WPF / .NET Framework 4.8&#10;Windows 8.0 is reported unsupported because the selected runtime baseline does not officially support it." Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>