<Window x:Class="NagiCore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NagiCore" Width="980" Height="620" MinWidth="850" MinHeight="540" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="NagiCore" Foreground="{StaticResource Text}" FontSize="30" FontWeight="Bold"/><TextBlock Text="All-in-One Windows Utility Suite" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Padding="14"><StackPanel>
<Button Content="Dashboard" Height="42" Margin="0,0,0,8" Click="Dashboard_Click"/><Button Content="Barcode" Height="42" Margin="0,0,0,8" Click="Module_Click"/><Button Content="Billing" Height="42" Margin="0,0,0,8" Click="Module_Click"/><Button Content="Discord Tools" Height="42" Margin="0,0,0,8" Click="Module_Click"/><Button Content="Windows Utilities" Height="42" Click="Module_Click"/>
</StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="28"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock x:Name="TitleText" Text="License activation" Foreground="{StaticResource Text}" FontSize="24" FontWeight="SemiBold"/>
<TextBlock Grid.Row="2" Text="Enter your NagiCore license key. The key is verified online." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
<StackPanel Grid.Row="3" Margin="0,22,0,0"><TextBox x:Name="KeyBox" Height="46" Padding="12" FontSize="15"/><Button x:Name="ActivateButton" Content="Activate NagiCore" Height="46" Margin="0,12,0,0" Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold" Click="Activate_Click"/><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel>
</Grid></Border></Grid></Grid></Window>